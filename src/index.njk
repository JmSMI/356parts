---
layout: base.njk
title: Porsche 356 Parts — Vancouver, BC
---

<div class="container">

  <div class="page-intro">
    <h1>Porsche 356 Parts</h1>
    <p>Used parts for sale in Vancouver, BC. Browse the listings below. Local pickup preferred; shipping within Canada by arrangement.</p>
    <div class="meta-chips">
      <span class="chip">Vancouver, BC</span>
      <span class="chip">Canada only</span>
      <span class="chip">Cash / e-Transfer</span>
      <span class="chip">Pickup preferred</span>
    </div>
  </div>

  <h2 class="catalog-heading" id="parts">Parts for sale</h2>
  <div class="filter-bar">
    <label class="search-label" for="part-search">Find a part
      <input id="part-search" type="search" placeholder="Search names, descriptions, categories…">
    </label>
    <span class="filter-label">Filter:</span>
    <button class="filter-btn active" data-filter="all" aria-pressed="true">All</button>
    {% set cats = [] %}
    {% for part in parts %}
      {% for cat in part | partCategories %}
        {% if cat not in cats %}
          {% set cats = cats.concat([cat]) %}
          <button class="filter-btn" data-filter="{{ cat }}" aria-pressed="false">{{ cat }}</button>
        {% endif %}
      {% endfor %}
    {% endfor %}
  </div>

  <div class="parts-section">
    <div class="parts-grid" id="parts-grid">
      {% for part in parts %}
        <a href="{{ ('/parts/' + part.id + '/') | url }}"
           class="part-card{% if part.status == 'sold' %} sold{% endif %}"
           data-categories="{{ (part | partCategories) | dump }}"
           data-search="{{ part.name }} {{ (part | partCategories) | join(' ') }} {{ part.description }} {{ part.status }} {{ part.notes }}">

          {% if part.status == 'sold' %}
            <span class="sold-badge">Sold</span>
          {% endif %}

          <div class="part-card-photo">
            {% if part.images and part.images.length > 0 %}
              {% if 'http' in part.images[0] %}
                <img src="{{ part.images[0] }}" alt="{{ part.name }}" loading="lazy">
              {% else %}
                <img src="{{ ('/parts/' + part.id + '/images/' + part.images[0]) | url }}" alt="{{ part.name }}" loading="lazy">
              {% endif %}
            {% else %}
              <div class="part-card-no-photo">No photo yet</div>
            {% endif %}
          </div>

          <div class="part-card-info">
            <div class="part-card-top">
              <span class="part-name">{{ part.name }}</span>
              <span class="category-tags">
                {% for cat in part | partCategories %}<span class="cat-tag {{ cat | categoryColor }}">{{ cat }}</span>{% endfor %}
              </span>
            </div>
            <div class="part-footer">
              <span class="part-price">{{ part.price }}</span>
              {% if part.status %}<span class="sale-status">Sale: {{ part.status }}</span>{% endif %}
            </div>
          </div>

        </a>
      {% endfor %}
    </div>
  </div>

  <p id="filter-result" role="status" aria-live="polite"></p>
  <section class="catalog-section" id="wanted" aria-labelledby="wanted-heading">
    <h2 id="wanted-heading">Parts wanted</h2>
    {% if wanted.length %}
    <ul class="wanted-bullets">
      {% for item in wanted %}
      <li>{{ item.name }}{% if item.description %} — {{ item.description }}{% endif %}</li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="section-empty">No wanted parts listed at the moment.</p>
    {% endif %}
  </section>


  <div class="contact-section" id="contact">
    <h2>Get in touch</h2>
    <p>Serious inquiries only. Please mention which part you're after and your general location. I'll respond within a day or two.</p>
    <a href="mailto:jpmoffat@gmail.com?subject=356%20Parts%20inquiry" class="contact-link">Send an email</a>
  </div>


</div>

<script>
  const btns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.part-card');
  const cardCategories = new Map([...cards].map(card => [card, JSON.parse(card.dataset.categories)]));
  const search = document.getElementById('part-search');
  let category = 'all';
  function applyFilters() {
    const words = search.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
    let count = 0;
    cards.forEach(card => {
      card.hidden = !((category === 'all' || cardCategories.get(card).includes(category)) && words.every(word => card.dataset.search.toLowerCase().includes(word)));
      if (!card.hidden) count++;
    });
    document.getElementById('filter-result').textContent = count ? `${count} ${count === 1 ? 'part' : 'parts'} found` : 'No matching parts. Try another keyword or category.';
  }
  search.addEventListener('input', applyFilters);

  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      btns.forEach(b => { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      category = btn.dataset.filter;
      applyFilters();
    });
  });
  applyFilters();
</script>
