---
layout: base.njk
pagination:
  data: parts
  size: 1
  alias: part
permalink: "parts/{{ part.id }}/"
eleventyComputed:
  title: "{{ part.name }} — 356 Parts"
  description: "{{ part.description }}"
---

<div class="container">
  <div class="part-detail">

    <div class="breadcrumb">
      <a href="{{ '/' | url }}">← All parts</a>
      <span>/</span>
      <span>{{ part.name }}</span>
    </div>

    <div class="detail-grid">

      <!-- Gallery -->
      <div class="gallery">
        <div class="gallery-main" id="gallery-main">
          {% if part.images and part.images.length > 0 %}
            {% set firstImg = part.images[0] %}
            {% if 'http' in firstImg %}
              {% set firstSrc = firstImg %}
            {% else %}
              {% set firstSrc = ('/parts/' + part.id + '/images/' + firstImg) | url %}
            {% endif %}
            <img id="main-img" src="{{ firstSrc }}" alt="{{ part.name }}">
          {% else %}
            <div class="gallery-placeholder">Photos coming soon</div>
          {% endif %}
        </div>

        {% if part.images and part.images.length > 1 %}
          <div class="gallery-thumbs">
            {% for img in part.images %}
              {% if 'http' in img %}
                {% set imgSrc = img %}
              {% else %}
                {% set imgSrc = ('/parts/' + part.id + '/images/' + img) | url %}
              {% endif %}
              <div class="gallery-thumb{% if loop.first %} active{% endif %}"
                   data-src="{{ imgSrc }}">
                <img src="{{ imgSrc }}" alt="{{ part.name }} photo {{ loop.index }}">
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <!-- Info -->
      <div class="detail-info">
        <div class="detail-header">
          <div class="category-tags">
            {% for cat in part | partCategories %}<span class="cat-tag {{ cat | categoryColor }}">{{ cat }}</span>{% endfor %}
          </div>
          <h1>{{ part.name }}</h1>
          <div class="detail-meta">
            <span class="detail-price">{{ part.price }}</span>
            {% if part.status %}<span class="sale-status">Sale: {{ part.status }}</span>{% endif %}
          </div>
        </div>

        <p class="detail-desc">{{ part.description }}</p>

        {% if part.notes %}
          <div class="detail-notes">{{ part.notes }}</div>
        {% endif %}

        {% if part.references and part.references.length %}
          <section class="part-references" aria-labelledby="references-heading">
            <h2 id="references-heading">Reference links</h2>
            <ul>
              {% for reference in part.references %}
              <li><a href="{{ reference.href }}" target="_blank" rel="noopener noreferrer">{{ reference.label or reference.href }}</a>{% if reference.note %}<p>{{ reference.note }}</p>{% endif %}</li>
              {% endfor %}
            </ul>
          </section>
        {% endif %}

        {% if part.status != 'sold' and part.status != 'not for sale' %}
          <div class="detail-contact">
            <a href="mailto:jpmoffat@gmail.com?subject={{ ('Inquiry: ' + part.name) | encodeUri }}" class="contact-link">
              Inquire about this part
            </a>
          </div>
        {% endif %}
      </div>

    </div>
  </div>
</div>

{% if part.images and part.images.length > 1 %}
<script>
  const mainImg = document.getElementById('main-img');
  const thumbs  = document.querySelectorAll('.gallery-thumb');
  thumbs.forEach(thumb => {
    thumb.addEventListener('click', () => {
      thumbs.forEach(t => t.classList.remove('active'));
      thumb.classList.add('active');
      mainImg.src = thumb.dataset.src;
    });
  });
</script>
{% endif %}
